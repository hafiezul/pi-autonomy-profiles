{
  "name": "pi-autonomy-profiles",
  "version": "0.2.2",
  "description": "Standalone Auto Mode commands, permission modes, and guardrails for Pi",
  "type": "module",
  "main": "./index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "auto-mode",
    "autonomy",
    "permissions",
    "standalone"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE",
    "package.json",
    "tsconfig.json",
    "schemas/autonomy.schema.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.79.0",
    "@types/node": "^24.12.4",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "prepack": "tsc --noEmit"
  }
}
